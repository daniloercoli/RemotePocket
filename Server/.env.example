# Local development. Copy to .env; never commit secrets.
MYDESK_ENVIRONMENT=dev
MYDESK_DEBUG=true
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
MYDESK_SECRET_KEY=dev-secret-change-me-in-production
MYDESK_DATABASE_URL=sqlite+pysqlite:///./mydesk.db
# Synchronous PostgreSQL: postgresql+psycopg2://mydesk:PASSWORD@localhost:5432/mydesk_dev
MYDESK_DATABASE_POOL_SIZE=10
MYDESK_DATABASE_MAX_OVERFLOW=20
MYDESK_DATABASE_POOL_RECYCLE_SECONDS=3600
MYDESK_REDIS_URL=redis://localhost:6379/0
# Dev uses an isolated in-memory limiter; staging/prod use Redis.
MYDESK_RATE_LIMIT_ENABLED=true
MYDESK_RATE_LIMIT_LOGIN=5
MYDESK_RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
MYDESK_RATE_LIMIT_REGISTER=3
MYDESK_RATE_LIMIT_REGISTER_WINDOW_SECONDS=3600
MYDESK_ACCESS_TOKEN_TTL_MINUTES=60
MYDESK_REFRESH_TOKEN_TTL_DAYS=30
MYDESK_MAX_CONCURRENT_SESSIONS=3
MYDESK_MAX_LOGIN_ATTEMPTS=5
MYDESK_LOCKOUT_DURATION_MINUTES=15
MYDESK_PAIRING_CODE_TTL_MINUTES=10
MYDESK_MIN_PASSWORD_LENGTH=8
MYDESK_REQUIRE_PASSWORD_UPPERCASE=true
MYDESK_REQUIRE_PASSWORD_LOWERCASE=true
MYDESK_REQUIRE_PASSWORD_NUMBER=true
MYDESK_REQUIRE_PASSWORD_SPECIAL=true
MYDESK_MIN_PASSWORD_STRENGTH=3
MYDESK_PASSWORD_HISTORY_COUNT=3
MYDESK_CHECK_PASSWORD_BREACHES=true
MYDESK_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
# Phase 3: keep this key stable and back it up separately from the database.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MYDESK_ENCRYPTION_KEY=
MYDESK_PUBLIC_BASE_URL=http://localhost:8000
# Without key, host and sender, email delivery remains unavailable.
MYDESK_SMTP_HOST=
MYDESK_SMTP_PORT=587
MYDESK_SMTP_FROM=
MYDESK_SMTP_USERNAME=
MYDESK_SMTP_PASSWORD=
MYDESK_SMTP_TLS=starttls
# TLS choices: starttls, ssl; none is only valid for localhost in dev.
MYDESK_EMAIL_OUTBOX_LIMIT=1000
MYDESK_MAX_REMOTE_SESSIONS=3
# Connection quotas include pending handshakes. Message quotas are per minute.
MYDESK_MAX_CONSOLE_CONNECTIONS=6
MYDESK_MAX_WEBSOCKET_CONNECTIONS=1000
MYDESK_RATE_LIMIT_WS_UPGRADE=30
MYDESK_RATE_LIMIT_WS_CONTROL=600
MYDESK_MAX_SCREEN_FRAMES_PER_SECOND=30
MYDESK_MAX_SCREEN_BYTES_PER_SECOND=10000000
# Production compose reads credentials from files under MYDESK_SECRETS_DIR.
# Set these non-secret variables in the deployment environment:
# MYDESK_DOMAIN=desk.example.com
# MYDESK_SECRETS_DIR=/etc/mydesk/secrets
# MYDESK_TLS_DIR=/etc/mydesk/tls
# MYDESK_ACME_DIR=/var/www/certbot

# Phase 2: metrics are served on the existing HTTP(S) /metrics endpoint.
MYDESK_LOG_LEVEL=INFO
MYDESK_METRICS_ENABLED=true
# Empty disables access to /metrics and detailed health. Use an independent random token.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
MYDESK_MONITORING_TOKEN=
MYDESK_TRACING_ENABLED=true
# Full OTLP HTTP traces URL (for example https://collector.example.com/v1/traces).
# Empty = no external export. Never put credentials in the URL.
MYDESK_TRACING_ENDPOINT=
MYDESK_TRACING_PROTOCOL=http
MYDESK_TRACING_INSECURE=false
MYDESK_HEALTH_CHECK_TIMEOUT_SECONDS=3
MYDESK_SHUTDOWN_TIMEOUT_SECONDS=30
MYDESK_WEBSOCKET_DRAIN_TIMEOUT_SECONDS=10
# Experimental transport only; staging/prod reject true until distributed lifecycle is complete.
MYDESK_REDIS_RELAY_ENABLED=false
